{
  "name": "Lane 1 Monorepo",
  "dockerComposeFile": ["docker-compose.yml", "../docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",

  // Läuft während des Prebuilds und wird im Snapshot zwischengespeichert
  // (npm ci ist der teuerste Schritt — genau der, den ein Prebuild sparen soll).
  "onCreateCommand": "npm ci && cp -n apps/api/.env.example apps/api/.env || true",
  "updateContentCommand": "npm ci",

  // Läuft NICHT während des Prebuilds, sondern bei jeder tatsächlichen
  // Codespace-Erstellung (danach steht die Postgres-Datenbank bereit).
  // `migrate deploy` statt `db push` (Code-Review, Befund W5): wendet die
  // committete Migrationshistorie unter apps/api/prisma/migrations/ an.
  "postCreateCommand": "cd apps/api && npm run prisma:generate && npx prisma migrate deploy && cd ../..",

  "forwardPorts": [3000, 5173, 5432],
  "portsAttributes": {
    "3000": { "label": "API (Fastify)", "onAutoForward": "notify" },
    "5173": { "label": "Web (PWA)", "onAutoForward": "openPreview" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "Prisma.prisma"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
