# apps/api/.env.example
#
# Vorlage für apps/api/.env — kopieren und Platzhalter durch echte Werte
# ersetzen. Vollständiges Schema samt Validierung: src/config/env.ts
# (dort bricht der Serverstart mit einer klaren Fehlermeldung ab, wenn ein
# Pflichtfeld fehlt oder ungültig ist). Schritt-für-Schritt-Anleitung für
# einen Produktivserver: docs/deployment.md, Abschnitt 7.2.

NODE_ENV=development
PORT=3000

# PostgreSQL-Verbindung.
DATABASE_URL="postgresql://lane1_app:CHANGE-ME@localhost:5432/lane1"

# Nur von der Umgebungsvalidierung verlangt (mind. 32 Zeichen) — aktuell
# von keiner Signierlogik verwendet (Access Tokens sind RS256-signiert,
# siehe JWT_PRIVATE_KEY/JWT_PUBLIC_KEY unten; Refresh-/Einladungs-Tokens
# sind opake Zufallswerte, kein JWT). Trotzdem PFLICHT. Erzeugen mit:
#   openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE-ME-mindestens-32-zeichen-lang

# RS256-Schlüsselpaar für die Access-Token-Signatur — PFLICHT, sobald
# NODE_ENV=production (der Start bricht sonst sofort ab). In development/
# test ohne diese Werte wird automatisch ein Wegwerf-Schlüsselpaar erzeugt
# (siehe src/auth/keys.ts) — für lokale Entwicklung können beide Felder
# also leer bleiben. Format: PEM, mit literalen "\n" statt echten
# Zeilenumbrüchen. Erzeugung siehe docs/deployment.md, Abschnitt 7.2.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Gültigkeitsdauer Access Token (Sekunden) bzw. Refresh Token (Tage).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Erlaubte Frontend-Origin (CORS). In Produktion NICHT "*" (wird von
# env.ts abgelehnt, da CORS mit credentials:true betrieben wird).
CORS_ORIGIN="http://localhost:5173"

# Basis-URL des Frontends — wird für den Link in der Einladungs-E-Mail
# gebraucht (Annahmeseite liegt dort unter "#/accept-invite/<token>").
FRONTEND_BASE_URL="http://localhost:5173"

# SMTP — Versand der Einladungs-E-Mail (Vereins-/Nutzerverwaltung). Bleibt
# SMTP_HOST leer, wird die Einladung nur ins Server-Log geschrieben statt
# tatsächlich per E-Mail versendet (praktisch für lokale Entwicklung ohne
# eigenen Mailserver, siehe src/mail/mailer.ts).
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE bewusst NICHT gesetzt: der Standardwert (false, passend zu
# Port 587 mit STARTTLS) gilt nur, wenn die Variable komplett fehlt. Wird
# sie explizit auf "false" gesetzt, macht die Validierung (zod
# z.coerce.boolean() -> Boolean("false") === true in JS) daraus fälschlich
# "true" (siehe src/config/env.ts). Nur bei Port 465 (implizites TLS) auf
# SMTP_SECURE=true setzen — das funktioniert korrekt.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="noreply@lane1.example.org"
SMTP_FROM_NAME="Lane 1"

# DSGVO (Art. 17): Tage zwischen einer Löschanfrage (sofortiger
# Soft-Delete) und dem endgültigen, unwiderruflichen Hard-Purge durch
# scripts/purgeDeletedData.ts (siehe dort für den empfohlenen Cronjob).
DATA_ERASURE_RETENTION_DAYS=30
