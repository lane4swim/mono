# apps/api/.env.example
#
# Vorlage für apps/api/.env — kopieren und Platzhalter durch echte Werte
# ersetzen. Vollständiges Schema samt Validierung: src/config/env.ts
# (dort bricht der Serverstart mit einer klaren Fehlermeldung ab, wenn ein
# Pflichtfeld fehlt oder ungültig ist). Schritt-für-Schritt-Anleitung für
# einen Produktivserver: docs/deployment.md, Abschnitt 7.2.

NODE_ENV=development

# Bind-Adresse des Node-Prozesses (Sicherheitsreview 2026-08-27, Befund
# N7). 127.0.0.1 passt zu jedem dokumentierten Deployment (siehe
# docs/deployment*.md — Nginx läuft dort auf demselben Host und spricht
# die API ausschließlich über 127.0.0.1 an). NUR im Container-Betrieb
# (docker-compose.yml/Dockerfile) auf 0.0.0.0 setzen — dort ist das
# bereits vorkonfiguriert, hier nichts zu tun.
HOST=127.0.0.1
PORT=3000

# PostgreSQL-Verbindung.
DATABASE_URL="postgresql://lane1_app:CHANGE-ME@localhost:5432/lane1"

# RS256-Schlüsselpaar für die Access-Token-Signatur — je Schlüssel PFLICHT,
# sobald NODE_ENV=production (der Start bricht sonst sofort ab). In
# development/test ohne diese Werte wird automatisch ein
# Wegwerf-Schlüsselpaar erzeugt (siehe src/auth/keys.ts) — für lokale
# Entwicklung können alle vier Felder unten also leer bleiben. Erzeugung
# siehe docs/deployment.md, Abschnitt 7.2.
#
# Zwei gleichwertige Formen je Schlüssel — GENAU EINE davon setzen, nie
# beide (env.ts lehnt sonst ab):
#   - JWT_PRIVATE_KEY/JWT_PUBLIC_KEY: PEM-Inhalt direkt hier, mit
#     literalen "\n" statt echten Zeilenumbrüchen.
#   - JWT_PRIVATE_KEY_FILE/JWT_PUBLIC_KEY_FILE (Sicherheitsreview
#     2026-08-28, Befund H2, Empfehlung 3 — EMPFOHLEN für Produktion):
#     Pfad zu einer PEM-Datei mit echten Zeilenumbrüchen, kein
#     \n-Escaping nötig. Der Vorteil gegenüber der Inline-Form: die
#     Schlüsseldatei lässt sich UNABHÄNGIG von dieser .env auf `chmod 600`
#     und das Dienstkonto beschränken (z. B. von einer Secrets-Management-
#     Lösung an einem eigenen Pfad bereitgestellt), statt dieselbe
#     Rechtestufe wie die übrige, weniger sensible Konfiguration zu
#     teilen — diese .env sollte ohnehin per `chmod 600` geschützt werden
#     (siehe docs/deployment.md, Abschnitt 7.2), die Datei-Form ist eine
#     zusätzliche Trennung, kein Ersatz dafür.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=

# Gültigkeitsdauer Access Token (Sekunden) bzw. Refresh Token (Tage).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Erlaubte Frontend-Origin(s) (CORS) — bei mehreren durch Komma getrennt
# (z. B. "https://training.mein-verein.de,https://staging.mein-verein.de").
# In Produktion NICHT "*" (wird von env.ts abgelehnt, da CORS mit
# credentials:true betrieben wird).
CORS_ORIGIN="http://localhost:5173"

# Kommagetrennte Liste der tatsächlich vertrauenswürdigen Reverse-Proxy-
# Adressen (Sicherheitsreview 2026-08-27, Befund H1) — bei jedem
# dokumentierten Deployment (siehe docs/deployment*.md) läuft Nginx auf
# demselben Host, der richtige Wert ist dort daher "127.0.0.1". PFLICHT in
# Produktion (der Serverstart bricht sonst mit einer klaren Fehlermeldung
# ab, siehe src/config/env.ts) — leer lassen wäre dort in jedem Fall
# sicherheitsrelevant falsch: entweder umgehbare Rate-Limits (bei
# "trustProxy: true") oder ein für alle Clients geteilter, kollabierter
# Zähler (ohne trustProxy). Für lokale Entwicklung/den docker-compose-
# Aufbau ohne vorgeschalteten Proxy bewusst leer lassen.
TRUSTED_PROXY_IPS=

# Basis-URL des Frontends — wird für den Link in der Einladungs-E-Mail
# gebraucht (Annahmeseite liegt dort unter "#/accept-invite/<token>").
FRONTEND_BASE_URL="http://localhost:5173"

# SMTP — Versand der Einladungs-E-Mail (Vereins-/Nutzerverwaltung). Bleibt
# SMTP_HOST leer, wird die Einladung nur ins Server-Log geschrieben statt
# tatsächlich per E-Mail versendet (praktisch für lokale Entwicklung ohne
# eigenen Mailserver, siehe src/mail/mailer.ts).
SMTP_HOST=
SMTP_PORT=587
# false (Port 587/STARTTLS) oder true (Port 465/implizites TLS) explizit
# setzen — beide werden korrekt ausgewertet. Bleibt die Zeile ganz weg,
# gilt ebenfalls false (Standardwert).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="noreply@lane1.example.org"
SMTP_FROM_NAME="Lane 1"

# DSGVO (Art. 17): Tage zwischen einer Löschanfrage (sofortiger
# Soft-Delete) und dem endgültigen, unwiderruflichen Hard-Purge durch
# scripts/purgeDeletedData.ts (siehe dort für den empfohlenen Cronjob).
DATA_ERASURE_RETENTION_DAYS=30

# Aufräum-Fristen für zwei intern buchführende Tabellen, die sonst
# unbegrenzt wachsen würden — ebenfalls per scripts/purgeDeletedData.ts
# bereinigt (siehe src/jobs/syncBookkeeping.repository.ts für die
# Begründung der unterschiedlichen Fristen):
#   - SYNC_EVENT_RETENTION_DAYS: Idempotenz-Ledger für POST /api/sync/push
#     (erkennt ein wiederholt gesendetes Event) — ein solcher Wiederholungs-
#     versuch geschieht praktisch immer innerhalb derselben Sitzung, nie
#     Wochen später.
#   - SYNC_TOMBSTONE_RETENTION_DAYS: Löschmarkierungen für endgültig
#     gepurgte Daten — muss so lange bestehen bleiben, bis JEDES Gerät
#     seinen Sync-Cursor darüber hinaus vorangetrieben hat, daher deutlich
#     großzügiger bemessen.
SYNC_EVENT_RETENTION_DAYS=90
SYNC_TOMBSTONE_RETENTION_DAYS=180
