// apps/api/prisma/schema.prisma
//
// Phase 2 (Datenmodell & Migrationen): vollständiges fachliches Datenmodell
// gemäß Abschnitt 4 des Backend-Entwicklungsplans — Mapping der bestehenden
// IndexedDB-Stores aus apps/web (js/db.js) auf Server-Tabellen.
//
// Wiederkehrende Konventionen für alle fachlichen Modelle:
//   - id: client-generierte UUID wird beibehalten (siehe apps/web/js/db.js:
//     uid()) — verhindert ID-Konflikte bei künftiger Offline-Erstellung und
//     macht einen Datensatz geräteübergreifend eindeutig identifizierbar.
//   - clubId: Mandantenfähigkeit — jede fachliche Zeile gehört zu genau
//     einem Verein.
//   - deletedAt: Soft-Delete statt Hard-Delete, wichtig für die künftige
//     Sync-API (Phase 3) — ein "Löschen" muss beim Pull auf einem anderen
//     Gerät als Löschung ankommen, nicht einfach fehlen.
//   - Verschachtelte/variable Strukturen (Sets/Blöcke in Plänen und
//     Vorlagen, Anwesenheitslisten in Einheiten) liegen als Json, da sie in
//     apps/web strukturgleich zum Frontend bleiben sollen (kein Mapping-
//     Verlust beim Sync).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id             String       @id @default(uuid())
  name           String
  // Modul-Pakete (z. B. "competitions" fürs Wettkampfmodul), die dieser
  // Verein gebucht hat — siehe packages/shared-types/src/modules.ts:
  // MODULE_PACKAGES für die gültigen Keys und deren Bedeutung. Steuert
  // sowohl die Frontend-Sichtbarkeit (apps/web/js/router.js) als auch
  // die Sync-Durchsetzung (apps/api/src/modules/sync/sync.permissions.ts).
  enabledModules String[]     @default([])
  // Externe Vereinskennung für den Ergebnisimport (DSV7/Lenex, siehe
  // docs/dsv7-lenex-import-plan.md Abschnitt 3.1) — generisch statt
  // DSV-spezifisch, damit auch andere Verbands-IDs (FINA, SwimRankings, …)
  // erfasst werden können. nationalIDType benennt das Format, z. B. "DSV"
  // für die 4-stellige DSV-Vereinskennzahl in nationalID.
  nationalID     String?
  nationalIDType String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  invitations    Invitation[]

  groups                        Group[]
  athletes                      Athlete[]
  competitions                  Competition[]
  entries                       StartlistEntry[]
  results                       Result[]
  exercises                     Exercise[]
  templates                     Template[]
  plans                         Plan[]
  sessions                      TrainingSession[]
  actionItems                   ActionItem[]
  qualificationReminderSettings ClubQualificationReminderSetting[]

  @@map("clubs")
}

model User {
  id                  String               @id @default(uuid())
  // null nur für role === "superadmin".
  clubId              String?
  club                Club?                @relation(fields: [clubId], references: [id])
  name                String
  email               String               @unique
  passwordHash        String
  role                String
  // Aufräumarbeit (Code-Review): vormals ein nackter String ohne
  // Fremdschlüssel/Unique-Constraint, obwohl jede andere Referenz in
  // diesem Schema sauber modelliert ist — zwei Konten hätten unbemerkt auf
  // dasselbe Athletenprofil zeigen können, und ein Hard-Purge (siehe
  // jobs/erasure.repository.ts) hätte hängende Referenzen hinterlassen
  // können. `@unique` erzwingt "höchstens ein Konto je Athletenprofil"
  // (die tatsächliche fachliche Regel — ein Athletenkonto IST diese
  // Person). `onDelete: SetNull` statt Cascade/Restrict: analog zu
  // Invitation.invitedById/ActionItem.assignedTrainerId oben — der
  // Purge-Job löscht das Athletenprofil INNERHALB derselben Transaktion,
  // in der direkt danach auch dieser User-Datensatz gelöscht wird; SetNull
  // verhindert, dass die Fremdschlüssel-Constraint diese Reihenfolge
  // blockiert, ohne den Purge-Ablauf selbst ändern zu müssen.
  athleteId           String?              @unique
  athlete             Athlete?             @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  // docs/kampfrichter-modul-plan.md, Abschnitt 1: ein Konto kann mehrere
  // Rollen gleichzeitig haben (z. B. Trainer:in UND Athlet:in). Löst
  // schrittweise "role" oben ab (expand -> migrate -> contract, siehe
  // Plan Abschnitt 1.3) — Anwendungscode liest/schreibt ab sofort
  // AUSSCHLIESSLICH "roles"; "role" bleibt vorerst als Sicherheitsnetz
  // bestehen (rein informativ, wird von PrismaUserRepository weiterhin
  // als roles[0] mitgepflegt, siehe auth.repository.ts), bis eine
  // spätere, eigene Migration die Spalte entfernt.
  roles               String[]             @default([])
  locale              String               @default("de-DE")
  // DSGVO: Zeitpunkt/Version der zuletzt bestätigten Einwilligung zur
  // Datenverarbeitung — wird bei jedem Login/jeder Registrierung erneut
  // gesetzt (siehe auth.service.ts: CURRENT_CONSENT_VERSION).
  consentGivenAt      DateTime?
  consentVersion      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // Sofort gesetzt, sobald eine Löschung beantragt wird (Recht auf
  // Löschung, Art. 17 DSGVO) — der Account ist ab dann funktionslos
  // (Login wird verweigert), der endgültige Hard-Purge aus der Datenbank
  // erfolgt zeitversetzt über DataDeletionRequest.purgeAfter.
  deletedAt           DateTime?
  refreshTokens       RefreshToken[]
  sentInvitations     Invitation[]         @relation("InvitationSender")
  deletionRequest     DataDeletionRequest?
  assignedActionItems ActionItem[]         @relation("ActionItemAssignedTrainer")
  passwordResetTokens PasswordResetToken[]
  qualifications      UserQualification[]

  // Ineffizienz-Korrektur: `clubId` ist zwar ein Fremdschlüssel, Postgres
  // legt darauf aber — anders als für UNIQUE-Spalten — KEINEN Index an.
  // Jede Mitgliederabfrage eines Vereins (auth.repository.ts:
  // listByClub(), das GET /api/users und GET /api/users/trainers bedient,
  // sowie invitations.repository.ts: countMembersByClub()) lief dadurch
  // als Sequential Scan über die GESAMTE users-Tabelle aller Vereine —
  // sichtbar erst mit wachsender Mandantenzahl, dann aber für jeden
  // Verein gleichzeitig. `deletedAt` steht mit im Index, weil beide
  // Abfragen ausnahmslos auf aktive (nicht gelöschte) Konten filtern.
  @@index([clubId, deletedAt])
  @@map("users")
}

// Recht auf Löschung (Art. 17 DSGVO): eine Löschanfrage wird sofort
// dokumentiert; der tatsächliche, unwiderrufliche Hard-Purge aus der
// Datenbank erfolgt erst nach Ablauf von purgeAfter (siehe
// src/jobs/purgeExpiredDeletions.ts) — das gibt eine kurze, angemessene
// Frist (Standard: 30 Tage, siehe DATA_ERASURE_RETENTION_DAYS in .env),
// z. B. für versehentliche Löschungen oder laufende Backup-Zyklen, erfüllt
// aber weiterhin die Pflicht zur Löschung "ohne unangemessene Verzögerung".
// Code-Review, Befund R8: `status`/`purgedAt` gestrichen. Der Hard-Purge
// löscht den User, und dieser Datensatz verschwindet per onDelete: Cascade
// mit — der Zustand "purged" war dadurch strukturell unerreichbar (jede
// noch EXISTIERENDE Zeile ist damit implizit "pending", ein separates
// Statusfeld dafür überflüssig). Siehe erasure.repository.ts:
// findDuePendingRequests() für die entsprechend vereinfachte Abfrage.
model DataDeletionRequest {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime @default(now())
  purgeAfter  DateTime

  @@index([purgeAfter])
  @@map("data_deletion_requests")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// "Passwort vergessen"-Flow (Sicherheitsreview 2026-08, Befund M5): analog
// zu Invitation/RefreshToken ein opakes, serverseitig nur gehasht
// gespeichertes Zufalls-Token (siehe auth/tokens.ts:
// generatePasswordResetToken()/hashPasswordResetToken()). Kurzlebig
// (Standard: 60 Minuten, siehe app.ts: PASSWORD_RESET_TTL_MINUTES) und
// EINMALIG einlösbar (usedAt) — deutlich kürzer als ein Einladungs-Token,
// da es ein bereits bestehendes Konto autorisiert, statt eine
// Erstregistrierung zu ermöglichen. onDelete: Cascade (wie RefreshToken):
// ein gelöschtes Konto braucht keine offenen Reset-Anfragen mehr.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Invitation {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  email       String
  // "admin" | "trainer" | "athlete" — "superadmin" wird nie per Einladung
  // vergeben (siehe scripts/createSuperAdmin.ts).
  role        String
  clubId      String?
  club        Club?     @relation(fields: [clubId], references: [id])
  athleteId   String?
  // Nullable + SetNull: eine Einladung soll als historischer Datensatz
  // bestehen bleiben, auch wenn das einladende Konto später selbst
  // gelöscht wird (z. B. ein ausscheidender Admin, der zuvor Trainer:innen
  // eingeladen hat) — die Löschung DIESES Kontos darf nicht an den von
  // ihm ausgestellten Einladungen scheitern.
  invitedById String?
  invitedBy   User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([clubId])
  @@map("invitations")
}

// ============================================================
// Fachliches Datenmodell (Phase 2) — Mapping siehe Tabelle in
// docs/backend-plan.md, Abschnitt 4.
// ============================================================

model Group {
  id          String    @id @default(uuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  athletes Athlete[]
  plans    Plan[]
  sessions TrainingSession[]

  // [clubId, updatedAt] statt nur [clubId]: bedient GENAU das Zugriffsmuster
  // von sync.gateway.ts: listChangedSince() — `WHERE clubId = ? [AND
  // updatedAt > ?] ORDER BY updatedAt` über jeden der zehn fachlichen
  // Stores, bei jedem Sync-Pull. Ein reiner [clubId]-Index deckt zwar die
  // Filterung ab, erzwingt für die Sortierung aber einen zusätzlichen
  // Sortierschritt; der zusammengesetzte Index bedient beides direkt und
  // macht den bisherigen [clubId]-Index überflüssig (ein Präfix-Scan auf
  // seiner ersten Spalte bedient auch reine "WHERE clubId = ?"-Abfragen
  // ohne updatedAt-Bedingung genauso gut, siehe Postgres-Doku zu
  // Mehrspalten-Indizes).
  @@index([clubId, updatedAt])
  @@map("groups")
}

model Athlete {
  id             String    @id @default(uuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  firstName      String
  lastName       String
  birthdate      DateTime?
  gender         String    @default("d") // "w" | "m" | "d"
  groupId        String?
  group          Group?    @relation(fields: [groupId], references: [id])
  joinDate       DateTime?
  active         Boolean   @default(true)
  notes          String    @default("")
  // Externe Athletenkennung für den Ergebnisimport (DSV7/Lenex, siehe
  // docs/dsv7-lenex-import-plan.md Abschnitt 3.1) — generisch, analog zu
  // Club.nationalID/nationalIDType. Erlaubt robusteres Matching gegen
  // Importzeilen als reiner Namensabgleich (z. B. bei Namensgleichheit).
  nationalID     String?
  nationalIDType String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  entries     StartlistEntry[]
  results     Result[]
  actionItems ActionItem[]
  // Rückreferenz zu User.athleteId (siehe dort) — höchstens EIN Konto pro
  // Athletenprofil, daher singulär statt eines Arrays.
  user        User?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@index([groupId])
  @@map("athletes")
}

model Competition {
  id        String    @id @default(uuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id])
  name      String
  date      DateTime
  location  String    @default("")
  course    String    @default("LCM") // "LCM" | "SCM"
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  entries StartlistEntry[]
  results Result[]

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@map("competitions")
}

// Startlisten-Einträge (Wettkampfnummer/Lauf/Bahn/Meldezeit) — entspricht
// dem "entries"-Store im Frontend.
model StartlistEntry {
  id            String      @id @default(uuid())
  clubId        String
  club          Club        @relation(fields: [clubId], references: [id])
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  athleteId     String
  athlete       Athlete     @relation(fields: [athleteId], references: [id])
  event         String
  eventNumber   String      @default("")
  heat          Int?
  lane          Int?
  seedTime      Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@index([competitionId])
  @@index([athleteId])
  @@map("startlist_entries")
}

model Result {
  id            String       @id @default(uuid())
  clubId        String
  club          Club         @relation(fields: [clubId], references: [id])
  athleteId     String
  athlete       Athlete      @relation(fields: [athleteId], references: [id])
  event         String
  // Nullable seit dem DSV7/Lenex-Ergebnisimport: bei status !== "OK" gibt
  // es keine gewertete Zeit (siehe ResultStatusSchema in
  // packages/shared-types/src/entities.ts).
  time          Float?
  date          DateTime
  course        String       @default("LCM")
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id])
  place         Int?
  isPB          Boolean      @default(false)
  // Rundenzeiten aus der Stoppuhr-Funktion (kumulierte Sekunden je Runde),
  // optional — siehe apps/web js/modules/competitions.js (buildStopwatchPanel).
  laps          Json?
  // Zwischenzeiten aus dem DSV7/Lenex-Ergebnisimport (Distanz + Zeit, ggf.
  // Staffel-Ablöser-Bezug) — bewusst getrennt von `laps` (Stoppuhr-Funktion,
  // andere Semantik). Siehe docs/dsv7-lenex-import-plan.md Abschnitt 3.3.
  splits        Json?
  // "OK" | "DS" (Disqualifikation) | "NA" (nicht angetreten) |
  // "AB" (abgemeldet) | "AU" (aufgegeben) | "ZU" (Zeitüberschreitung) —
  // direkte Übernahme der DSV7-Codes für "Grund der Nichtwertung", siehe
  // docs/dsv7-lenex-import-plan.md Abschnitt 3.4. Bei status !== "OK" ist
  // `time` bedeutungslos (Platzhalter aus der Importdatei wird nicht
  // übernommen).
  status        String       @default("OK")
  statusNote    String?
  // Diskussions-/Hinweiskommentare zum Ergebnis — Struktur siehe
  // CommentSchema in packages/shared-types/src/entities.ts. Bleibt bei
  // einem Ergebnisimport (Überschreiben von time/place/splits/status)
  // unangetastet erhalten, siehe docs/dsv7-lenex-import-plan.md Abschnitt 5.
  comments      Json         @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@index([athleteId])
  @@index([competitionId])
  @@map("results")
}

model Exercise {
  id              String    @id @default(uuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  name            String
  category        String
  stroke          String?
  description     String    @default("")
  defaultDistance Int?
  tags            String[]  @default([])
  equipment       String[]  @default([])
  // Diskussions-/Hinweiskommentare im Übungskatalog — Struktur siehe
  // CommentSchema in packages/shared-types/src/entities.ts. Als Json
  // gespeichert (analog zu Template.sets/Plan.days), da es sich um eine
  // eingebettete Liste handelt, keine eigenständig referenzierte Entität.
  comments        Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@map("exercises")
}

// Wiederverwendbare Trainingsplan-Vorlagen. `sets` bleibt strukturgleich
// zum Frontend (Mix aus einzelnen Sätzen und Wiederholungsblöcken, siehe
// apps/web js/modules/setEditor.js) und liegt daher als Json statt in
// normalisierten Zeilen — vermeidet verlustbehaftetes Mapping beim Sync.
model Template {
  id          String    @id @default(uuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  name        String
  description String    @default("")
  tags        String[]  @default([])
  sets        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@map("templates")
}

model Plan {
  id        String    @id @default(uuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id])
  name      String
  weekStart DateTime
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id])
  status    String    @default("aktiv") // "aktiv" | "archiv"
  // Array von { date, sets } — je Tag dieselbe Sets/Blöcke-Struktur wie
  // Template.sets. Einzelne Sätze können jeweils ein eigenes
  // "comments"-Array tragen (siehe CommentSchema) — das lebt mit im
  // selben Json-Blob, es gibt dafür keine eigene Spalte.
  days      Json
  // Kommentare zum gesamten Plan (nicht zu einem einzelnen Satz).
  comments  Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions TrainingSession[]

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@index([groupId])
  @@map("plans")
}

// Heißt "TrainingSession" (nicht "Session"), um Verwechslung mit
// Auth-/HTTP-Session-Konzepten zu vermeiden — Tabelle bleibt "sessions".
model TrainingSession {
  id          String    @id @default(uuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  date        DateTime
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id])
  planId      String?
  plan        Plan?     @relation(fields: [planId], references: [id])
  trainerNote String    @default("")
  // Array von { athleteId, present, rpe, note } — ein Eintrag je Athlet:in.
  attendance  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@index([groupId])
  @@index([planId])
  @@map("sessions")
}

model ActionItem {
  id                String    @id @default(uuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  athleteId         String
  athlete           Athlete   @relation(fields: [athleteId], references: [id])
  title             String
  description       String    @default("")
  category          String
  status            String    @default("offen") // "offen" | "progress" | "done"
  // Zuständige Person (Trainer:in oder Admin). Nullable + SetNull statt
  // Pflichtfeld mit Cascade — analog zu Invitation.invitedById (siehe dort):
  // ein späteres DSGVO-Hard-Purge des zuständigen Kontos soll das
  // Handlungsfeld als historischen Datensatz nicht mitreißen, sondern nur
  // die Zuordnung auflösen. Der Standardwert (Erfasser:in ist zuständig)
  // wird clientseitig beim Anlegen gesetzt (siehe
  // apps/web/js/modules/actionItems.js: openItemModal).
  assignedTrainerId String?
  assignedTrainer   User?     @relation("ActionItemAssignedTrainer", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  createdDate       DateTime
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // [clubId, updatedAt] statt [clubId] — siehe Begründung bei Group oben
  // (Sync-Pull-Zugriffsmuster).
  @@index([clubId, updatedAt])
  @@index([athleteId])
  @@index([assignedTrainerId])
  @@map("action_items")
}

// ============================================================
// Phase 3 — Sync-API (Push/Pull, Idempotenz, Konfliktlogik).
// ============================================================

// Idempotenz-Ledger für POST /api/sync/push: die Client-generierte
// Event-id (identisch mit der id in der lokalen Sync-Warteschlange,
// siehe apps/web/js/db.js: enqueueSyncEvent) wird hier als Primärschlüssel
// geführt. Ein wiederholt gesendetes Event (z. B. nach Verbindungsabbruch
// mitten in der Antwort) wird dadurch nicht doppelt angewendet — vor dem
// Verarbeiten wird geprüft, ob die id schon existiert.
model SyncedEvent {
  id        String   @id // = SyncEvent.id vom Client, keine eigene UUID
  clubId    String
  store     String
  action    String // "create" | "update" | "delete"
  appliedAt DateTime @default(now())

  @@index([clubId])
  @@map("synced_events")
}

// Verbesserung: Löschungen bleiben auch nach dem endgültigen Hard-Purge
// eines Kontos (siehe jobs/purgeExpiredDeletions.ts) über die Sync-API
// meldbar. Bewusst OHNE Fremdschlüssel-Beziehung zu irgendeiner Tabelle —
// das ist der ganze Zweck: ein Tombstone muss unabhängig vom (bereits
// gelöschten) referenzierten Datensatz weiterbestehen können. Enthält
// keine Personendaten, nur die id und den Löschzeitpunkt.
model SyncTombstone {
  id        String   @id @default(uuid())
  clubId    String
  store     String
  entityId  String
  deletedAt DateTime @default(now())

  @@unique([clubId, store, entityId])
  @@index([clubId, deletedAt])
  @@map("sync_tombstones")
}

// ============================================================
// Qualifikationsmanagement (docs/nutzer-qualifikationen-plan.md).
// Bewusst KEIN Sync-Store (siehe Plan, Abschnitt 1.1): User ist selbst
// kein Sync-Store, Qualifikationen sind Metadaten dazu und werden über
// eigene REST-Endpunkte im qualifications-Modul verwaltet, nicht über
// POST /api/sync/push.
// ============================================================

// Erfasste Qualifikation einer Person (Trainerlizenz, Rettungsschwimmschein,
// Erste-Hilfe-Kurs, …). onDelete: Cascade — analog RefreshToken/PasswordResetToken:
// ein gelöschtes Konto braucht keine eigenständig fortbestehenden Nachweise mehr.
model UserQualification {
  id                       String    @id @default(uuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Feste Werteliste (siehe QualificationTypeSchema, packages/shared-types/
  // src/qualification.ts) — kein Fremdschlüssel, da (noch) kein Enum als
  // eigene Tabelle (siehe Plan, Entscheidung zu Frage 1).
  type                     String
  // Freitext-Zusatz, z. B. Kursanbieter/Zertifikatsnummer.
  note                     String    @default("")
  acquiredOn               DateTime
  // Nullable: nicht jede Qualifikation läuft ab.
  expiresOn                DateTime?
  // Datum eines bereits organisierten Verlängerungs-/Auffrischungslehrgangs
  // — dient zugleich als Flag ("ist etwas organisiert?", != null) und als
  // Datumsangabe (siehe Plan, Abschnitt 2.1).
  renewalCourseOrganizedOn DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  reminderLogs QualificationReminderLog[]

  // Zugriffsmuster: "alle Qualifikationen einer Person" (eigene Ansicht/
  // Nutzerverwaltung) und "alle bald ablaufenden Qualifikationen"
  // (Erinnerungsjob) — letzteres geht über User.clubId, kein direkter
  // clubId-Fremdschlüssel hier nötig.
  @@index([userId, deletedAt])
  @@index([expiresOn])
  @@map("user_qualifications")
}

// Verhindert Doppelversand bei mehrfachem Cron-Lauf des Erinnerungsjobs
// (jobs/notifyExpiringQualifications.ts) — je erreichter Schwelle
// (thresholdDays; 0 steht für "bereits abgelaufen", siehe dortiger
// EXPIRED_MARKER-Kommentar) wird höchstens EINMAL erinnert. onDelete:
// Cascade — eine gelöschte Qualifikation braucht keine eigene
// Versandhistorie mehr.
model QualificationReminderLog {
  id              String            @id @default(uuid())
  qualificationId String
  qualification   UserQualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  thresholdDays   Int
  sentAt          DateTime          @default(now())

  @@unique([qualificationId, thresholdDays])
  @@map("qualification_reminder_logs")
}

// Je Verein und Qualifikationstyp konfigurierbare Vorlaufzeiten (in Tagen
// vor expiresOn) für Ablauf-Erinnerungen (siehe Plan, Abschnitt 2.4 und
// Entscheidung zu Frage 4). Fehlt eine Zeile für eine (clubId, type)-
// Kombination, gilt der Fallback DEFAULT_QUALIFICATION_REMINDER_THRESHOLDS_DAYS
// (packages/shared-types/src/qualification.ts) — ein Verein muss also
// nichts konfigurieren, um sinnvolle Erinnerungen zu bekommen.
model ClubQualificationReminderSetting {
  id             String   @id @default(uuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  type           String
  // Tage vor expiresOn, an denen je einmalig erinnert wird, z. B. [60, 14].
  thresholdsDays Int[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clubId, type])
  @@map("club_qualification_reminder_settings")
}
