{
  "name": "lane1-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Lane 1 — Trainingsmanagement für Schwimmteams. Monorepo: PWA-Frontend (apps/web) + Node.js-Backend (apps/api) + gemeinsame Pakete (packages/*).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^10.9.1",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.68.0",
    "globals": "^17.11.0"
  }
}
